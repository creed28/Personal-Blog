# --- Blog content (local only, never committed) ---
# Posts (public and private) live only on this machine. See README "Private posts".
/content/

# --- Dependencies ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Build output ---
/dist/
/dist-ssr/
*.tsbuildinfo
node_modules/.tmp/
node_modules/.vite/

# --- Testing ---
/coverage/

# --- Vercel (project link, pulled env, prebuilt output) ---
.vercel/

# --- Environment variables ---
.env
.env.*
!.env.example
*.local

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Caches ---
.eslintcache
.prettiercache
.cache/

# --- Secrets / certificates ---
*.pem
*.key

# --- Editors / IDEs ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

